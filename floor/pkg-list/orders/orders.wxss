/* 订单列表 —— 基于设计系统 token */
.page-orders {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索入口 */
.search-wrap {
  margin-bottom: 20rpx;
}
.search-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--surface);
  border-radius: var(--r-pill);
  padding: 18rpx 28rpx;
  box-shadow: var(--shadow-1);
}
.search-ico {
  color: var(--text-3);
}
.search-ph {
  font-size: 26rpx;
  color: var(--text-3);
}

/* 状态筛选 tabs */
.tabs-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  background: var(--surface);
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-1);
  transition: all 0.2s ease;
}
.tab-item.active {
  background: var(--brand);
  box-shadow: var(--shadow-brand);
}
.tab-name {
  font-size: 26rpx;
  color: var(--text-2);
}
.tab-item.active .tab-name {
  color: #fff;
  font-weight: 600;
}
.tab-count {
  min-width: 32rpx;
  padding: 0 10rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand);
}
.tab-item.active .tab-count {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

/* 订单卡片 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.order-card {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
  padding: 24rpx 28rpx;
}

/* 行 1：状态 + 时间 */
.oc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-chip {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
}
.sc-pending {
  background: var(--brand-soft);
  color: var(--brand);
}
.sc-preparing {
  background: #FFF7E6;
  color: var(--warn);
}
.sc-delivering {
  background: #E8F4FD;
  color: #1677D9;
}
.sc-completed {
  background: #EDFAF2;
  color: var(--success);
}
.oc-time {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 行 2：商家 */
.oc-store {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 22rpx;
}
.oc-store-ico {
  color: var(--text-2);
}
.oc-store-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.oc-arrow {
  width: 24rpx;
  height: 24rpx;
  color: var(--text-3);
}

/* 行 3：商品 */
.oc-items {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--bg);
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.oc-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.oc-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
}
.oc-thumb-ph {
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.oc-thumb-ph .i {
  width: 32rpx;
  height: 32rpx;
  color: var(--brand);
}
.oc-item-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.oc-item-qty {
  font-size: 24rpx;
  color: var(--text-3);
}
.oc-item-price {
  font-size: 26rpx;
  color: var(--text-2);
  min-width: 80rpx;
  text-align: right;
}

/* 行 4：金额 + 操作 */
.oc-foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}
.oc-total {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.oc-total-label {
  font-size: 24rpx;
  color: var(--text-3);
}
.oc-total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
}
.oc-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.act-btn {
  font-size: 26rpx;
  padding: 12rpx 30rpx;
  border-radius: var(--r-pill);
  text-align: center;
  transition: all 0.15s ease;
}
.act-btn.primary {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-brand);
}
.act-btn.ghost {
  background: var(--surface);
  color: var(--text-2);
  border: 1rpx solid var(--line);
}
.act-btn.danger {
  background: var(--surface);
  color: var(--danger);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-ico {
  width: 96rpx;
  height: 96rpx;
  color: var(--text-3);
  opacity: 0.5;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.empty-btn {
  margin-top: 36rpx;
  padding: 16rpx 60rpx;
}
