<!-- 订单列表：信息层级 = 状态 → 商家 → 商品 → 金额 → 操作 -->
<view class="page-orders">
  <!-- 搜索入口 -->
  <view class="search-wrap">
    <view class="search-pill" bindtap="onSearchOrders" hover-class="press-hover">
      <text class="i i-search search-ico"></text>
      <text class="search-ph">搜索订单号 / 商家</text>
    </view>
  </view>

  <!-- 状态筛选：横向滚动 pills -->
  <scroll-view class="tabs-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="tab-item {{activeTab === item.status ? 'active' : ''}}"
          wx:for="{{statusTabs}}" wx:key="status"
          bindtap="onTabChange" data-status="{{item.status}}"
          hover-class="press-hover">
      <text class="tab-name">{{item.name}}</text>
      <text class="tab-count" wx:if="{{item.count > 0}}">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 订单卡片 -->
  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="orderId"
          bindtap="onOrderDetail" data-order-id="{{item.orderId}}"
          hover-class="press-hover">
      <!-- 行 1：状态 + 时间 -->
      <view class="oc-head">
        <view class="status-chip sc-{{item.statusClass}}">{{item.statusText}}</view>
        <text class="oc-time">{{item.orderTime}}</text>
      </view>

      <!-- 行 2：商家 -->
      <view class="oc-store">
        <text class="i i-store oc-store-ico"></text>
        <text class="oc-store-name">{{item.storeName}}</text>
        <text class="i i-chev-right oc-arrow"></text>
      </view>

      <!-- 行 3：商品（有图显示缩略图，无图显示占位图标） -->
      <view class="oc-items" wx:if="{{item.items.length > 0}}">
        <view class="oc-item" wx:for="{{item.items}}" wx:for-item="food" wx:key="index">
          <image wx:if="{{food.image}}" class="oc-thumb" src="{{food.image}}" mode="aspectFill" lazy-load />
          <view wx:else class="oc-thumb oc-thumb-ph"><text class="i i-store"></text></view>
          <text class="oc-item-name">{{food.name}}</text>
          <text class="oc-item-qty">x{{food.quantity}}</text>
          <text class="oc-item-price">¥{{food.price}}</text>
        </view>
      </view>

      <!-- 行 4：金额 + 操作（操作按钮 catchtap，避免冒泡触发卡片跳转） -->
      <view class="oc-foot">
        <view class="oc-total">
          <text class="oc-total-label">实付</text>
          <text class="oc-total-price">¥{{item.finalAmount}}</text>
        </view>
        <view class="oc-actions">
          <block wx:if="{{item.status === '待付款'}}">
            <view class="act-btn ghost" catchtap="onCancelOrder" data-order-id="{{item.orderId}}">取消订单</view>
            <view class="act-btn primary" catchtap="onPayOrder" data-order-id="{{item.orderId}}">去支付</view>
          </block>
          <block wx:if="{{item.status === '制作中'}}">
            <view class="act-btn ghost" catchtap="onRemindOrder" data-order-id="{{item.orderId}}">催单</view>
          </block>
          <block wx:if="{{item.status === '配送中'}}">
            <view class="act-btn ghost" catchtap="onTrackOrder" data-order-id="{{item.orderId}}">查看配送</view>
            <view class="act-btn primary" catchtap="onConfirmReceive" data-order-id="{{item.orderId}}">确认收货</view>
          </block>
          <block wx:if="{{item.status === '已完成'}}">
            <view class="act-btn ghost" catchtap="onReviewOrder" data-order-id="{{item.orderId}}">去评价</view>
            <view class="act-btn ghost" catchtap="onOrderAgain" data-order-id="{{item.orderId}}">再来一单</view>
          </block>
        </view>
      </view>
    </view>

    <!-- 加载失败重试 -->
    <error-retry wx:if="{{loadError}}" message="订单加载失败" bind:retry="onLoadRetry"></error-retry>

    <!-- 空态 -->
    <view class="empty" wx:if="{{orders.length === 0 && !loading}}">
      <text class="i i-bag empty-ico"></text>
      <text class="empty-title">还没有相关订单</text>
      <text class="empty-desc">去首页逛逛，发现更多美食</text>
      <view class="act-btn primary empty-btn" bindtap="onGoShopping" hover-class="press-hover">去逛逛</view>
    </view>
  </view>
</view>
