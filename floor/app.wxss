/**app.wxss - 大众点评风格全局样式**/

/* CSS 变量 */
page {
  --primary: #FF6633;
  --primary-light: #FF8855;
  --primary-dark: #E55520;
  --orange: #FF8C00;
  --star-color: #FFB800;
  --bg: #F5F5F5;
  --bg-white: #FFFFFF;
  --text-main: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --text-placeholder: #CCCCCC;
  --border: #EEEEEE;
  --divider: #F0F0F0;
  --shadow: rgba(0, 0, 0, 0.06);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
  box-sizing: border-box;
}

/* 全局容器 */
.container {
  width: 100%;
  box-sizing: border-box;
  /* 块级布局：子元素默认全宽，避免旧模板的 flex 居中把内容压成细条 */
  display: block;
  box-sizing: border-box;
}

/* Font Awesome 图标样式 */
.fa {
  font-family: 'FontAwesome';
}

/* 通用按钮 */
.btn {
  border-radius: var(--radius-lg);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-primary-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-ghost {
  background: rgba(255, 102, 51, 0.08);
  color: var(--primary);
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border);
  border-top: 4rpx solid var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #F5F5F5 25%, #EAEAEA 50%, #F5F5F5 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-light);
}

.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  color: var(--text-placeholder);
}

.empty-state-text {
  font-size: 30rpx;
  margin-bottom: 8rpx;
  color: var(--text-secondary);
}

.empty-state-subtext {
  font-size: 26rpx;
  color: var(--text-light);
}

/* 通用卡片 */
.card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  margin: 20rpx 24rpx;
  overflow: hidden;
}

.card-body {
  padding: 24rpx;
}

/* 通用分割线 */
.divider {
  height: 1rpx;
  background: var(--divider);
  margin: 0 24rpx;
}

/* 通用 flex 工具 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 文本截断 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 评分星星 */
.stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stars .fa-star {
  color: var(--star-color);
  font-size: 24rpx;
}

.stars .fa-star.empty {
  color: var(--text-placeholder);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  background: rgba(255, 102, 51, 0.08);
  color: var(--primary);
}

.tag-primary {
  background: var(--primary);
  color: #fff;
}

/* 价格 */
.price {
  color: var(--primary);
  font-weight: 600;
}

.price-symbol {
  font-size: 24rpx;
}

.price-integer {
  font-size: 40rpx;
  font-weight: 700;
}

.price-decimal {
  font-size: 28rpx;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==========================================================================
   设计系统 Design System v2 —— 语义 Token / 阴影 / 圆角 / 动效 / SVG 图标
   色彩角色：--brand 主色(CTA/强调) --bg 页面底 --surface 卡面 --text-1/2/3 文字层级
   ========================================================================== */
page {
  --brand: #FF6633;
  --brand-deep: #EE5522;
  --brand-soft: #FFF0EB;
  --bg: #F6F7F9;
  --surface: #FFFFFF;
  --text-1: #191B20;
  --text-2: #6E7278;
  --text-3: #A0A3AA;
  --line: #EFEFF2;
  --success: #17B26A;
  --danger: #EF4444;
  --warn: #FF9F2E;
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-pill: 999rpx;
  --shadow-1: 0 6rpx 20rpx rgba(23, 25, 32, 0.06);
  --shadow-2: 0 12rpx 32rpx rgba(23, 25, 32, 0.10);
  --shadow-brand: 0 10rpx 28rpx rgba(255, 102, 51, 0.28);
  background-color: var(--bg);
}

/* —— 卡片与按压反馈 —— */
.ds-card {
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.press { transition: transform 0.15s ease, opacity 0.15s ease; }
.press-hover { transform: scale(0.97); opacity: 0.85; }

@keyframes ds-fade-up {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.ds-fade-up { animation: ds-fade-up 0.35s ease both; }
.ds-fade-up-1 { animation: ds-fade-up 0.35s ease 0.05s both; }
.ds-fade-up-2 { animation: ds-fade-up 0.35s ease 0.12s both; }
.ds-fade-up-3 { animation: ds-fade-up 0.35s ease 0.19s both; }

/* —— SVG 图标系统（CSS mask 实现，颜色随 currentColor，替代 emoji）—— */
.i {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
  flex-shrink: 0;
  vertical-align: middle;
}
.i-sm { width: 26rpx; height: 26rpx; }
.i-lg { width: 40rpx; height: 40rpx; }
.i-xl { width: 48rpx; height: 48rpx; }








































