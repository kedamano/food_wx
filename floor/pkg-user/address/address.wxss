/* 收货地址 —— 基于设计系统 token */
.page-address {
  padding: 24rpx 24rpx 200rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 选择模式提示条 */
.select-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--brand-soft);
  color: var(--brand);
  border-radius: var(--r-md);
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

/* 地址卡片 */
.addr-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.addr-card {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
  padding: 28rpx;
}
.addr-card.is-default {
  border: 1rpx solid rgba(255, 102, 51, 0.35);
}

/* 联系人行 */
.ac-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.ac-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.ac-phone {
  font-size: 28rpx;
  color: var(--text-2);
}
.ac-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand);
}
.ac-tag-work {
  background: #E8F4FD;
  color: #1677D9;
}
.ac-default-chip {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
  color: #fff;
}
.ac-default-ico {
  width: 20rpx;
  height: 20rpx;
}

/* 地址行 */
.ac-detail {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
}

/* 操作行：文字按钮，按语义着色 */
.ac-actions {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 36rpx;
}
.ac-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.ac-action.brand {
  color: var(--brand);
  margin-right: auto; /* 设为默认靠左，编辑/删除靠右 */
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0 60rpx;
}
.empty-ico {
  width: 96rpx;
  height: 96rpx;
  color: var(--text-3);
  opacity: 0.5;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 加载态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
.loading-text {
  font-size: 26rpx;
  color: var(--text-3);
}

/* 底部固定：新增主按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg) 70%, rgba(246, 247, 249, 0));
}
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 92rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-brand);
}
