/* 登录设备管理 —— 设计系统 token 版 */
.page-devices {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
}

.device-item.current {
  border: 2rpx solid var(--brand);
}

.device-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--brand-soft);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.device-icon .i {
  width: 36rpx;
  height: 36rpx;
}

.device-info {
  flex: 1;
  min-width: 0;
}

.device-header {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.device-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-badge {
  margin-left: 14rpx;
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: var(--r-pill);
}

.device-type {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-meta {
  display: flex;
  align-items: center;
}

.meta-ico {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  color: var(--text-3);
}

.meta-text {
  font-size: 22rpx;
  color: var(--text-3);
}

.device-action {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.unbind-btn {
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: var(--danger);
  background: var(--surface);
  border: 1rpx solid rgba(239, 68, 68, 0.35);
  border-radius: var(--r-pill);
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-ico {
  width: 80rpx;
  height: 80rpx;
  color: var(--text-3);
  opacity: 0.5;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* 全部解绑 */
.action-section {
  margin-top: 30rpx;
}

.danger-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger);
  background: var(--surface);
  border: 1rpx solid rgba(239, 68, 68, 0.35);
  border-radius: var(--r-pill);
}

/* 安全提示 */
.security-tip {
  display: flex;
  gap: 18rpx;
  padding: 28rpx;
  margin-top: 30rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
}

.tip-ico {
  width: 34rpx;
  height: 34rpx;
  color: var(--brand);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.7;
}
